generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GameResult {
  id             String   @id @default(cuid())
  userId         String
  dateKey        String
  mode           String   @default("daily-movie")
  status         String
  guessIds       Int[]
  attemptCount   Int
  hintsUsed      Int
  completedAt    DateTime @default(now())
  targetMovieId  Int      @default(0)
  targetTitle    String   @default("")
  targetYear     Int      @default(0)
  targetPoster   String   @default("")
  extraAttempts  Int      @default(0)
  paidHintUsed   Boolean  @default(false)
  paidHintsCount Int      @default(0)

  @@unique([userId, dateKey, mode])
  @@index([userId])
  @@index([userId, completedAt])
}

model UserStats {
  id             String  @id @default(cuid())
  userId         String  @unique
  gamesPlayed    Int     @default(0)
  gamesWon       Int     @default(0)
  currentStreak  Int     @default(0)
  maxStreak      Int     @default(0)
  averageGuesses Float   @default(0)
  lastPlayedDate String?
}

model SavedMovie {
  id         String    @id @default(cuid())
  userId     String
  tmdbId     Int
  title      String
  year       Int
  posterPath String
  genres     String[]
  director   String    @default("")
  overview   String    @default("")
  runtime    Int       @default(0)
  tmdbRating Float     @default(0)
  category   String // "watched" | "watchlist"
  rating     Float?
  review     String?
  watchedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, category])
  @@index([userId, createdAt])
}

model RankedList {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       RankedListItem[]

  @@index([userId])
}

model RankedListItem {
  id         String     @id @default(cuid())
  listId     String
  tmdbId     Int
  title      String
  year       Int
  posterPath String
  genres     String[]
  director   String     @default("")
  overview   String     @default("")
  position   Int

  list       RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId])
  @@index([listId, position])
  @@index([listId])
}

model UserWallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Int      @default(0)
  streakFreezes Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  dateKey   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model DailyUsage {
  key       String   @id // e.g. "recommend:userId:2026-05-05"
  count     Int      @default(0)
  date      String   // "YYYY-MM-DD" — for cleanup queries
  updatedAt DateTime @updatedAt

  @@index([date])
}

model DuelRoom {
  code                 String    @id
  status               String    @default("waiting")
  hostId               String
  hostName             String
  guestId              String?
  guestName            String?
  questions            Json
  currentRound         Int       @default(0)
  hostScore             Int       @default(0)
  guestScore            Int       @default(0)
  hostAnsweredRound     Int       @default(-1)
  guestAnsweredRound    Int       @default(-1)
  roundWinnerId         String?
  roundStartedAt        DateTime?
  roundEndsAt           DateTime?
  roundResolvedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  expiresAt             DateTime

  @@index([status])
  @@index([expiresAt])
}

model MovieEmbedding {
  tmdbId     Int                          @id
  title      String
  year       Int
  genres     String[]
  overview   String
  score        Float                      @default(0)
  posterPath   String                     @default("")
  backdropPath String                     @default("")
  director   String                       @default("Unknown")
  leadActor  String                       @default("Unknown")
  country    String                       @default("Unknown")
  runtime    Int                          @default(0)
  budget     Int                          @default(0)
  voteCount  Int                          @default(0)
  rating     Float                        @default(0)
  tagline    String?
  cast       Json                         @default("[]")
  embedding  Unsupported("vector(1536)")

  @@index([year])
}
