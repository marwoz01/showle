# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Canonical public origin. Set the final HTTPS domain before a production build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Operator identity and contact. Review legal pages against actual operations first.
SHOWLE_DATA_CONTROLLER=""
SHOWLE_CONTACT_EMAIL=""
SHOWLE_LEGAL_READY="false"

# Operations bearer token, at least 32 random characters. Never use NEXT_PUBLIC_.
OPS_SECRET=""
# Vercel is detected automatically. Outside Vercel use forwarded ONLY behind a
# trusted proxy that replaces client-supplied forwarding headers.
TRUSTED_PROXY=""
# Production always uses PostgreSQL limits; use postgres to exercise them in dev.
RATE_LIMIT_BACKEND=""

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# TMDB API (https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your-tmdb-api-key"

# OpenRouter (https://openrouter.ai/keys) - query interpretation and relevance review
OPENROUTER_API_KEY="your-openrouter-api-key"
RECOMMENDATION_CHAT_MODEL="google/gemini-2.5-flash-lite"

# Google Gemini (https://aistudio.google.com/apikey) - embeddings for /api/recommend
GEMINI_API_KEY="your-gemini-api-key"

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN="sntrys_..."
